GEMINI_API_KEY=your-gemini-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Same default as config.py. To see which models your key can use:
#   docker compose run --rm backend python -m app.list_models
CHAT_MODEL=gemini-3.8-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768

DATABASE_URL=ask-the-team-lead-for-this

# Rate limits per client IP. Set RATE_LIMIT_ENABLED=false to switch them off (for load tests).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_TICKETS_PER_MIN=10
RATE_LIMIT_ACTIONS_PER_MIN=20

# n8n actions (optional, compose profile "n8n"). Inside the backend container use the
# service name, not localhost. Run n8n with: docker compose --profile n8n up -d n8n
N8N_WEBHOOK_URL=http://n8n:5678/webhook
# Optional shared secret. The backend sends it in the X-Webhook-Secret header and the
# workflows check it. Leave empty to turn the check off. Use a long random value.
N8N_WEBHOOK_SECRET=
# Optional: key n8n uses to encrypt its stored credentials. Use a long random value.
N8N_ENCRYPTION_KEY=

# Login. SESSION_SECRET signs the session cookie: use a long random value (at least 32
# characters). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Login is refused while it is empty.
SESSION_SECRET=generate-a-long-random-string
# Session lifetime in hours.
SESSION_HOURS=4
# Set to true when the site is served over https, so the cookie is only sent over https.
COOKIE_SECURE=false
# Used only by init_db, on a local database, for the three demo users (min 8 characters).
DEMO_PASSWORD=choose-a-demo-password
# Failed login limits per window (minutes).
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_MINUTES=10

# Save every chat exchange (conversations and messages). Set to false for a full-mode load test.
PERSIST_CHATS=true

# AI provider calls. One attempt times out after these many seconds. A slow model may need a higher
# CHAT_TIMEOUT_SECONDS. LLM_CALL_BUDGET_SECONDS is the total for one call, retries included.
CHAT_TIMEOUT_SECONDS=30
EMBED_TIMEOUT_SECONDS=20
LLM_CALL_BUDGET_SECONDS=45
